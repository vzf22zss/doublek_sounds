{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoubleK Visuals",
  "version": "../package.json",
  "identifier": "com.doublek.visuals",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "DoubleK — Controle",
        "url": "control.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#07070b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "DoubleK",
    "shortDescription": "Logo reativa ao som para projeção ao vivo",
    "category": "Video",
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QzBEOTM0QThENUZCNTIKUldSUys5V29OTm5BRkVVNVhrTnhhWkt5T3VwTXhsaWd3VWtmQ0FxaVBoZFU0L3V3M1VRamZjdWMK",
      "endpoints": [
        "https://github.com/vzf22zss/doublek_sounds/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
