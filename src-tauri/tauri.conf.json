{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoubleK Visuals",
  "version": "0.1.0",
  "identifier": "com.doublek.visuals",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "DoubleK — Controle",
        "url": "control.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#07070b"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
